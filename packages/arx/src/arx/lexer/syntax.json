{
  "syntax_pack_version": "0.8.0",
  "language": "arx",
  "status": "draft",
  "source_of_truth": "Canonical lexical source for editor tooling and lexer tables.",
  "file_extensions": [".x", ".arx"],
  "keywords": {
    "reserved": [
      "assert",
      "class",
      "const",
      "else",
      "extern",
      "fn",
      "for",
      "if",
      "import",
      "in",
      "return",
      "then",
      "var",
      "while"
    ],
    "contextual": ["as", "from", "type", "binary", "unary", "operator"]
  },
  "literals": {
    "keywords": ["true", "false", "none"],
    "booleans": {
      "true": true,
      "false": false
    },
    "none": {
      "token_value": null
    }
  },
  "comments": {
    "line": {
      "enabled": true,
      "delimiters": ["#"]
    },
    "block": {
      "enabled": false,
      "open": "",
      "close": "",
      "nesting": false
    }
  },
  "strings": {
    "supported": true,
    "quote_types": ["single", "double"],
    "triple_quotes": false,
    "raw_prefixes": [],
    "escapes": ["\\\\", "\\n", "\\r", "\\t", "\\\"", "\\'"],
    "interpolation": {
      "enabled": false,
      "start": "",
      "end": ""
    }
  },
  "docstrings": {
    "supported": true,
    "delimiter": "```",
    "token_kind": "docstring"
  },
  "numbers": {
    "formats": ["decimal_integer", "decimal_float"],
    "bases": [10],
    "underscores": {
      "allowed": false
    },
    "suffixes": [],
    "exponent": {
      "allowed": false,
      "forms": []
    },
    "leading_dot_float": true,
    "trailing_dot_float": true,
    "multiple_dots": "invalid"
  },
  "identifiers": {
    "start": "Unicode letter or underscore",
    "continue": "Unicode alphanumeric or underscore",
    "pattern": "(?:[_\\p{L}])(?:[_\\p{L}\\p{N}])*",
    "unicode_policy": "Current runtime behavior"
  },
  "whitespace": {
    "indentation_significant": true,
    "indent_unit": 2,
    "indent_unit_kind": "spaces",
    "tabs": "forbidden_or_error",
    "newlines_significant": true,
    "blank_lines": "ignored_for_indentation_transitions"
  },
  "operators": {
    "single_char": [
      "=",
      "<",
      ">",
      "+",
      "-",
      "*",
      "/",
      "%",
      ".",
      ":",
      ",",
      ";",
      "@",
      "|",
      "!",
      "(",
      ")",
      "[",
      "]",
      "{",
      "}"
    ],
    "multi_char": ["==", "!=", "<=", ">=", "->", "&&", "||", "++", "--"],
    "word_operators": ["and", "or"],
    "assignment": ["="],
    "comparison": ["<", ">", "<=", ">=", "==", "!="],
    "arithmetic": ["+", "-", "*", "/", "%"],
    "logical": ["&&", "||", "and", "or", "!"],
    "type_union": ["|"],
    "punctuation": ["@", ":", ",", ";", "."]
  },
  "structural_forms": {
    "annotations": {
      "start": "@[",
      "separator": ",",
      "end": "]",
      "modifiers": [
        "public",
        "private",
        "protected",
        "static",
        "constant",
        "mutable",
        "abstract",
        "extern"
      ]
    },
    "template_parameter_block": {
      "start": "@<",
      "separator": ",",
      "end": ">"
    },
    "explicit_template_call": {
      "uses_angle_brackets": true
    },
    "grouped_imports": {
      "supported": true,
      "requires_from": true,
      "allows_trailing_comma": true
    },
    "type_alias": {
      "form": "type Name = type",
      "supports_union_rhs": true,
      "top_level_only": true
    },
    "relative_imports": {
      "leading_dot_tokens": true
    },
    "dataframe_type": {
      "static_schema": "dataframe[name: type, ...]",
      "runtime_schema_parameter": "dataframe[...]"
    },
    "series_type": {
      "form": "series[type]"
    },
    "dataframe_constructor": {
      "form": "dataframe({name: [literal, ...], ...})",
      "column_access": ["value.name", "value[\"name\"]"]
    }
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "builtins": {
    "types": [
      "i8",
      "i16",
      "i32",
      "i64",
      "int8",
      "int16",
      "int32",
      "int64",
      "f16",
      "f32",
      "f64",
      "float16",
      "float32",
      "float64",
      "bool",
      "boolean",
      "none",
      "str",
      "string",
      "char",
      "datetime",
      "timestamp",
      "date",
      "time",
      "dataframe",
      "list",
      "series",
      "tensor",
      "datatype",
      "field",
      "schema",
      "array",
      "u8",
      "u16",
      "u32",
      "u64",
      "uint8",
      "uint16",
      "uint32",
      "uint64",
      "array_builder",
      "chunked_array",
      "table",
      "record_batch",
      "scalar"
    ],
    "functions": [
      "cast",
      "dataframe",
      "isinstance",
      "print",
      "range",
      "type",
      "schema_nfields",
      "schema_field",
      "field_type",
      "field_nullable",
      "descriptor_equal",
      "type_bit_width",
      "type_nfields",
      "type_field",
      "field_name",
      "conversion_kind",
      "is_null",
      "is_valid",
      "expect_valid",
      "array",
      "array_length",
      "array_null_count",
      "array_offset",
      "array_at",
      "array_slice",
      "array_concat",
      "array_copy",
      "array_equal",
      "array_builder",
      "chunked_array",
      "builder_append",
      "builder_reserve",
      "builder_length",
      "builder_finish",
      "chunk_count",
      "chunk_at",
      "combine_chunks",
      "table",
      "record_batch",
      "num_rows",
      "num_columns",
      "container_schema",
      "column",
      "column_as",
      "slice_rows",
      "select_columns",
      "rename_columns",
      "add_column",
      "replace_column",
      "remove_column",
      "to_table",
      "to_record_batch",
      "table_combine_chunks",
      "runtime_schema",
      "scalar",
      "scalar_equal",
      "scalar_text",
      "scalar_values",
      "scalar_field",
      "scalar_bytes",
      "take_rows",
      "array_from_buffer"
    ]
  },
  "descriptor_syntax": {
    "status": "descriptor values only; not general columnar value support",
    "literals": [
      "datatype[logical_type]",
      "field[name: logical_type | none]",
      "schema[name: logical_type | none, ...]"
    ],
    "parameters": "kind(name=literal, ...)[child: logical_type, ...]",
    "metadata": "optional {key: value, ...} UTF-8 strings or identifiers",
    "conversion_kind": "compile-time classification of two datatype or schema literals"
  },
  "nullable_syntax": {
    "type": "T | none",
    "payloads": "Primitive numeric/Boolean values; shared scalar, array, chunked_array, datatype, field, schema, table, record_batch and class owners; unique builders",
    "queries": ["is_null(value)", "is_valid(value)", "expect_valid(value)"],
    "operators": "primitive arithmetic and comparisons propagate null; Boolean and/or use short-circuit Kleene logic",
    "casts": "cast(value, T | none) preserves validity for primitive payloads; expect_valid is required to unwrap",
    "fields": "nullable instance fields and primitive IRx struct fields; no nullable strings or static fields"
  },
  "array_syntax": {
    "type": "array[T] or array[T | none]",
    "literal": "array[T](values...)",
    "types": "Primitive, binary/string, temporal, decimal, interval and recursive logical values; extension values are rejected.",
    "iteration": "explicit indexed scalar access with array_at; no implicit iteration",
    "builders": "array_builder[T]() owns a reusable unique builder; builder_finish resets it.",
    "chunks": "chunked_array[T](array[T], ...) has explicit chunk_at and combine_chunks."
  },
  "tabular_syntax": {
    "types": [
      "record_batch[fields]{metadata}",
      "table[fields]{metadata}",
      "record_batch",
      "table"
    ],
    "constructors": "A static schema, an explicit signed row count, then ordered array columns for batches or chunked_array columns for tables.",
    "projection": "column(value, literal_name) requires a static schema; column_as(value, index, field[...]) checks a runtime field exactly.",
    "runtime_schema": "Explicitly erase static schema facts while retaining an independent owner.",
    "iteration": "Explicit indexed column, row-slice, chunk and scalar operations; no implicit iteration axis.",
    "value_coverage": "Primitive and non-extension logical columns, including nullable, half-float and recursive nested values."
  },
  "scalar_syntax": {
    "constructor": "scalar[logical_type](values...)",
    "nullable": "scalar[logical_type] | none",
    "queries": [
      "scalar_equal",
      "scalar_text",
      "scalar_values",
      "scalar_field",
      "scalar_bytes"
    ]
  }
}
